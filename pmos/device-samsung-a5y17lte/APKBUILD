# Reference: <https://postmarketos.org/devicepkg>
maintainer="Jimmy <fakeandroit@gmail.com>"
pkgname=device-samsung-a5y17lte
pkgdesc="Samsung Galaxy A5 (2017)"
pkgver=3
pkgrel=6
url="https://github.com/android-a5y7lte/xnu-a5y17lte"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# /etc/greetd/config.toml is greetd-agreety-config's; ours (autologin into Phosh) replaces it
replaces="greetd-agreety-config"
depends="
	linux-postmarketos-exynos7880
	postmarketos-base
	phosh
	phoc
	squeekboard
	greetd
	greetd-agreety
	elogind
	polkit-elogind
	mesa-dri-gallium
	mesa-egl
	mesa-gles
	linux-firmware-ath10k
	wireless-regdb
	iw
"
makedepends="devicepkg-dev"
subpackages="$pkgname-openrc:openrc"
install="$pkgname-openrc.post-install $pkgname-openrc.post-upgrade"
source="
	deviceinfo
	90-a5y17lte-usb0.conf
	unudhcpd.usb0.confd
	a5y17lte-usbnet
	a5y17lte-usbnet.initd
	a5-phosh-session
	a5y17lte-greetd.toml
	a5y17lte-phoc.ini
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/90-a5y17lte-usb0.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/90-a5y17lte-usb0.conf
	install -Dm755 "$srcdir"/a5y17lte-usbnet "$pkgdir"/usr/bin/a5y17lte-usbnet
	# Phosh on simpledrm (EVIDENCE 32): software rendering, autologin, scale 2
	install -Dm755 "$srcdir"/a5-phosh-session "$pkgdir"/usr/bin/a5-phosh-session
	install -Dm644 "$srcdir"/a5y17lte-greetd.toml "$pkgdir"/etc/greetd/config.toml
	install -Dm644 "$srcdir"/a5y17lte-phoc.ini "$pkgdir"/etc/phosh/phoc.ini
}

openrc() {
	# hwclock -> swclock (no RTC driver yet, see the post-install), and
	# unudhcpd on usb0 answers as 172.16.42.1, a5y17lte-usbnet routes through the PC
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install $subpkgname.post-upgrade"
	depends="openrc elogind-openrc greetd-openrc dbus-openrc"
	install -Dm644 "$srcdir"/unudhcpd.usb0.confd \
		"$subpkgdir"/etc/conf.d/unudhcpd.usb0
	install -Dm755 "$srcdir"/a5y17lte-usbnet.initd \
		"$subpkgdir"/etc/init.d/a5y17lte-usbnet
}

sha512sums="
"
