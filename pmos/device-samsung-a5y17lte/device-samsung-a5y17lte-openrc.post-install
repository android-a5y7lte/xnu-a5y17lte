#!/bin/sh
# No RTC driver yet (S2MPU05 RTC): hwclock fails at every boot. swclock
# keeps the clock moving forward from the last shutdown instead.
rc-update -q del hwclock boot 2>/dev/null
rc-update -q add swclock boot
# USB internet through the PC (EVIDENCE 26): default route service, and a
# resolv.conf that works without systemd-resolved (the stub 127.0.0.53 that
# pmOS ships has no resolver behind it under OpenRC)
rc-update -q add a5y17lte-usbnet default
if grep -q '^nameserver 127\.0\.0\.53' /etc/resolv.conf 2>/dev/null; then
	printf 'nameserver 1.1.1.1\nnameserver 9.9.9.9\n' > /etc/resolv.conf
fi
# Phosh (EVIDENCE 32): greetd logs "user" into it on tty1, so the tty1 getty goes
rc-update -q add elogind default
rc-update -q add polkit default
rc-update -q add greetd default
if [ -f /etc/inittab ]; then
	sed -i 's|^\(tty1::respawn:\)|#a5y17lte (greetd owns tty1) \1|' /etc/inittab
fi
exit 0
