+/*
+ * a5y17lte reset bisect (EVIDENCE 29), debug only: with A5_UBRST=N (build
+ * option UBRST=N) boot_jump_linux() draws a white stripe (row 130 + 70 * N),
+ * triggers DECON, waits 2 s on the counter and writes PMU SWRESET at point N:
+ * 1 = start of boot_jump_linux(), 2 = after bootm_final(), 3 = after
+ * cleanup_before_linux().
+ */
+static void a5_ubrst(int n)
+{
+	u32 *fb = (u32 *)(0x67000000UL + (130 + 70 * n) * 4320UL);
+	u64 t, c;
+	int i;
+
+	if (n != A5_UBRST)
+		return;
+	for (i = 0; i < 40 * 1080; i++)
+		fb[i] = 0xffffffff;
+	*(volatile u32 *)0x14830070 = 0x10;
+	asm volatile("dsb sy");
+	asm volatile("mrs %0, cntvct_el0" : "=r"(t));
+	do {
+		asm volatile("mrs %0, cntvct_el0" : "=r"(c));
+	} while (c - t < 52000000UL);
+	*(volatile u32 *)0x106b0400 = 1;
+	for (;;)
+		asm volatile("wfi");
+}
