From f62de114b1b546673430cb0ca59feb108f52cf8c Mon Sep 17 00:00:00 2001
From: Jimmy <fakeandroit@gmail.com>
Date: Sat, 7 Nov 2026 22:12:02 +0200
Subject: [PATCH 19/20] dt-bindings: reset: add the Exynos7880 audio subsystem
 resets

The audio subsystem of the Exynos7880 has one register with the software
reset bits of its mixer, I2S, amplifier interface and DMA controller.
Describe it as a reset controller.

Assisted-by: Claude:claude-sonnet-5-5
---
 .../reset/samsung,exynos7880-lpass-reset.yaml | 41 +++++++++++++++++++
 1 file changed, 41 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/reset/samsung,exynos7880-lpass-reset.yaml

diff --git a/Documentation/devicetree/bindings/reset/samsung,exynos7880-lpass-reset.yaml b/Documentation/devicetree/bindings/reset/samsung,exynos7880-lpass-reset.yaml
new file mode 100644
index 000000000..242a57033
--- /dev/null
+++ b/Documentation/devicetree/bindings/reset/samsung,exynos7880-lpass-reset.yaml
@@ -0,0 +1,41 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/reset/samsung,exynos7880-lpass-reset.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos7880 audio subsystem software resets
+
+maintainers:
+  - Jimmy <fakeandroit@gmail.com>
+
+description:
+  One register of the audio subsystem holds the software reset bits of its
+  blocks, the audio mixer (0), the I2S (1), the amplifier interface (2) and
+  the audio DMA controller (3). The blocks have to be reset once after boot
+  before they work, so deasserting a reset line first pulses the bit.
+
+properties:
+  compatible:
+    const: samsung,exynos7880-lpass-reset
+
+  reg:
+    maxItems: 1
+
+  '#reset-cells':
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - '#reset-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    reset-controller@148f1000 {
+        compatible = "samsung,exynos7880-lpass-reset";
+        reg = <0x148f1000 0x4>;
+        #reset-cells = <1>;
+    };
-- 
