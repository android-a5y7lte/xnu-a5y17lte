From 9eba0f346d635b0eb3b253cbe1b0a46d06b18f67 Mon Sep 17 00:00:00 2001
From: Jimmy <fakeandroit@gmail.com>
Date: Sat, 31 Oct 2026 23:33:48 +0200
Subject: [PATCH 15/16] dt-bindings: power: supply: add the Samsung S2MU004
 charger

The charger block of the S2MU004 PMIC, found in the Galaxy A5 (2017),
sits at I2C address 0x3d together with the MUIC. Describe it.

Assisted-by: Claude:claude-sonnet-5-5
---
 .../power/supply/samsung,s2mu004-charger.yaml | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/samsung,s2mu004-charger.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/samsung,s2mu004-charger.yaml b/Documentation/devicetree/bindings/power/supply/samsung,s2mu004-charger.yaml
new file mode 100644
index 000000000..92541f27c
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/samsung,s2mu004-charger.yaml
@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/samsung,s2mu004-charger.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Battery charger of the Samsung S2MU004 PMIC
+
+maintainers:
+  - Jimmy <fakeandroit@gmail.com>
+
+description:
+  The charger block of the Samsung S2MU004 PMIC, which also holds the MUIC
+  that routes the USB data lines. This binding only describes the part that
+  reports whether a valid power input is present.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: samsung,s2mu004-charger
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      charger@3d {
+        compatible = "samsung,s2mu004-charger";
+        reg = <0x3d>;
+      };
+    };
-- 
