From 13ba000e9344276eff55b4cb253c59419c62727a Mon Sep 17 00:00:00 2001
From: Jimmy <fakeandroit@gmail.com>
Date: Fri, 30 Oct 2026 17:49:56 +0200
Subject: [PATCH 10/11] dt-bindings: display: samsung: add Exynos7880 DECON_F
 hand-off

Add the binding for the DECON_F display controller of the Exynos7880 and
its graphics DMA channel (IDMA_G1), as found for example in the Samsung
Galaxy A5 (2017).

The binding describes a driver that adopts the pipeline the bootloader
started for its splash screen. The controller, the DSI link and the panel
are left as they are, and the driver only scans out buffers by moving the
base address of the DMA channel. The mode and the physical size come from
the devicetree.

Assisted-by: Claude:claude-sonnet-5-5
---
 .../samsung/samsung,exynos7880-decon.yaml     | 78 +++++++++++++++++++
 1 file changed, 78 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/samsung/samsung,exynos7880-decon.yaml

diff --git a/Documentation/devicetree/bindings/display/samsung/samsung,exynos7880-decon.yaml b/Documentation/devicetree/bindings/display/samsung/samsung,exynos7880-decon.yaml
new file mode 100644
index 000000000..25eb12a1a
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/samsung/samsung,exynos7880-decon.yaml
@@ -0,0 +1,78 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/samsung/samsung,exynos7880-decon.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos7880 DECON_F display controller (bootloader hand-off)
+
+maintainers:
+  - Jimmy <fakeandroit@gmail.com>
+
+description:
+  The DECON_F display controller and its graphics DMA channel of the Exynos7880,
+  in command mode with a hardware (TE) trigger. This binding describes a driver
+  that adopts the pipeline the bootloader started for its splash screen: the
+  controller, the DSI link and the panel are left as they are, and the driver
+  only scans out buffers by moving the base address of the DMA channel the
+  bootloader used.
+
+properties:
+  compatible:
+    const: samsung,exynos7880-decon
+
+  reg:
+    items:
+      - description: DECON_F registers
+      - description: Graphics DMA channel (IDMA_G1) registers
+
+  reg-names:
+    items:
+      - const: decon
+      - const: idma
+
+  width-mm:
+    description: Physical width of the panel.
+
+  height-mm:
+    description: Physical height of the panel.
+
+  display-timings:
+    $ref: /schemas/display/panel/display-timings.yaml#
+    description:
+      The mode the bootloader set up (the native timing is used). Its active
+      size has to match the size programmed in the controller.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - display-timings
+
+additionalProperties: false
+
+examples:
+  - |
+    display-controller@14830000 {
+        compatible = "samsung,exynos7880-decon";
+        reg = <0x14830000 0x10000>, <0x14822000 0x1000>;
+        reg-names = "decon", "idma";
+        width-mm = <65>;
+        height-mm = <115>;
+
+        display-timings {
+            native-mode = <&timing0>;
+
+            timing0: timing-0 {
+                clock-frequency = <126342840>;
+                hactive = <1080>;
+                vactive = <1920>;
+                hfront-porch = <2>;
+                hback-porch = <2>;
+                hsync-len = <2>;
+                vfront-porch = <3>;
+                vback-porch = <15>;
+                vsync-len = <1>;
+            };
+        };
+    };
