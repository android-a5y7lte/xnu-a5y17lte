From a38e46ff85d6b192649f2e6c604e1e99585c98c6 Mon Sep 17 00:00:00 2001
From: Jimmy <fakeandroit@gmail.com>
Date: Fri, 30 Oct 2026 17:49:57 +0200
Subject: [PATCH] drm/tiny: add Exynos7880 DECON_F bootloader hand-off driver

The display controller of the Exynos7880 is of the DECON_F family used
since the Exynos8 generation, which has a different register layout from
the Exynos7 and Exynos5433 controllers the exynos DRM driver supports.

On the Galaxy A5 (2017) the bootloader leaves a working pipeline behind
for its splash screen: IDMA_G1 reads a framebuffer and feeds window 0 of
the DECON_F, which refreshes a MIPI DSI command mode panel with the
hardware (TE) trigger. This driver adopts that pipeline instead of
reprogramming it. At probe it checks that the controller runs in command
mode with the expected size and that window 0 is fed by IDMA_G1, takes
over the framebuffer aperture from the firmware framebuffer driver, and
then scans out DRM framebuffers by writing the base address of the DMA
channel, which the controller picks up with the next TE trigger.

Nothing else is touched: the DSI link, the panel, the clocks and the power
domains stay as the bootloader left them. The vertical blank is emulated
with a timer for now. Only packed buffers of the panel size are accepted,
which is what the DMA channel is set up for.

The register layout was read from the live controller on the A5 and
checked against the vendor driver.

Assisted-by: Claude:claude-sonnet-5-5
---
 drivers/gpu/drm/tiny/Kconfig            |  18 ++
 drivers/gpu/drm/tiny/Makefile           |   1 +
 drivers/gpu/drm/tiny/exynos7880-decon.c | 403 ++++++++++++++++++++++++
 3 files changed, 422 insertions(+)
 create mode 100644 drivers/gpu/drm/tiny/exynos7880-decon.c

diff --git a/drivers/gpu/drm/tiny/Kconfig b/drivers/gpu/drm/tiny/Kconfig
index f0e72d4b6..043c263df 100644
--- a/drivers/gpu/drm/tiny/Kconfig
+++ b/drivers/gpu/drm/tiny/Kconfig
@@ -24,6 +24,24 @@ config DRM_ARCPGU
 
 	  If M is selected the module will be called arcpgu.
 
+config DRM_EXYNOS7880_DECON
+	tristate "Exynos7880 DECON_F (bootloader hand-off)"
+	depends on DRM && OF
+	depends on ARCH_EXYNOS || COMPILE_TEST
+	select APERTURE_HELPERS
+	select DRM_CLIENT_SELECTION
+	select DRM_GEM_DMA_HELPER
+	select DRM_KMS_HELPER
+	select VIDEOMODE_HELPERS
+	help
+	  Choose this option for the display controller of the Samsung
+	  Exynos7880 SoC (for example in the Galaxy A5 2017). The driver
+	  adopts the display pipeline that the bootloader started for its
+	  splash screen and scans out buffers through it; it does not
+	  set up the display link or the panel itself.
+
+	  If M is selected the module will be called exynos7880-decon.
+
 config DRM_BOCHS
 	tristate "DRM Support for bochs dispi vga interface (qemu stdvga)"
 	depends on DRM && PCI && MMU
diff --git a/drivers/gpu/drm/tiny/Makefile b/drivers/gpu/drm/tiny/Makefile
index 48d30bf61..e3cd2d5b7 100644
--- a/drivers/gpu/drm/tiny/Makefile
+++ b/drivers/gpu/drm/tiny/Makefile
@@ -4,6 +4,7 @@ obj-$(CONFIG_DRM_APPLETBDRM)		+= appletbdrm.o
 obj-$(CONFIG_DRM_ARCPGU)		+= arcpgu.o
 obj-$(CONFIG_DRM_BOCHS)			+= bochs.o
 obj-$(CONFIG_DRM_CIRRUS_QEMU)		+= cirrus-qemu.o
+obj-$(CONFIG_DRM_EXYNOS7880_DECON)	+= exynos7880-decon.o
 obj-$(CONFIG_DRM_GM12U320)		+= gm12u320.o
 obj-$(CONFIG_DRM_PANEL_MIPI_DBI)	+= panel-mipi-dbi.o
 obj-$(CONFIG_DRM_PIXPAPER)              += pixpaper.o
diff --git a/drivers/gpu/drm/tiny/exynos7880-decon.c b/drivers/gpu/drm/tiny/exynos7880-decon.c
new file mode 100644
index 000000000..18d265f1a
--- /dev/null
+++ b/drivers/gpu/drm/tiny/exynos7880-decon.c
@@ -0,0 +1,403 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos7880 DECON_F display controller, bootloader hand-off
+ *
+ * The bootloader starts the display pipeline for its splash screen: a graphics
+ * DMA channel (IDMA_G1) feeds window 0 of the DECON_F, which drives a MIPI DSI
+ * command mode panel through its hardware (TE) trigger. This driver adopts that
+ * pipeline as it is. It checks that it is running, replaces the firmware
+ * framebuffer driver and scans out buffers by writing the base address of the
+ * DMA channel, which the controller picks up on the next TE trigger.
+ *
+ * Nothing else is touched: the DSI link, the panel, the clocks and the power
+ * domains stay as the bootloader left them. The vertical blank is emulated with
+ * a timer.
+ */
+
+#include <linux/aperture.h>
+#include <linux/bitfield.h>
+#include <linux/dma-mapping.h>
+#include <linux/hrtimer.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include <drm/clients/drm_client_setup.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fbdev_dma.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_module.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+#include <drm/drm_vblank.h>
+
+#include <video/of_display_timing.h>
+
+/* DECON_F registers */
+#define DECON_GLOBAL_CONTROL		0x0000
+#define  DECON_GLOBAL_CONTROL_I80IF	BIT(8)	/* command mode */
+#define  DECON_GLOBAL_CONTROL_RUN	BIT(4)
+#define DECON_DISPIF0_SIZE_CONTROL_0	0x00a0	/* height << 16 | width */
+#define  DECON_SIZE_HEIGHT(x)		(((x) >> 16) & 0x1fff)
+#define  DECON_SIZE_WIDTH(x)		((x) & 0x1fff)
+#define DECON_WIN_CONTROL(n)		(0x0130 + (n) * 0x20)
+#define  DECON_WIN_CONTROL_EN		BIT(0)
+#define  DECON_WIN_CONTROL_CHMAP	GENMASK(14, 12)
+#define DECON_WIN_END_POSITION(n)	(0x0138 + (n) * 0x20)
+#define  DECON_CHMAP_IDMA_G1		0	/* channel map of IDMA_G1 */
+
+/* IDMA_G1 registers */
+#define IDMA_PINGPONG_UPDATE		0x001c	/* BIT(0): latch the base address */
+#define IDMA_BASE_ADDR			0x0074
+
+struct exynos7880_decon {
+	struct drm_device drm;
+	struct drm_simple_display_pipe pipe;
+	struct drm_connector connector;
+	void __iomem *decon;
+	void __iomem *idma;
+	struct drm_display_mode mode;
+	u32 width_mm;
+	u32 height_mm;
+	struct hrtimer vblank_timer;
+	ktime_t vblank_period;
+};
+
+static struct exynos7880_decon *to_decon(struct drm_device *drm)
+{
+	return container_of(drm, struct exynos7880_decon, drm);
+}
+
+static struct exynos7880_decon *pipe_to_decon(struct drm_simple_display_pipe *pipe)
+{
+	return container_of(pipe, struct exynos7880_decon, pipe);
+}
+
+static const u32 exynos7880_decon_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+};
+
+/* Connector: always connected, one fixed mode */
+
+static int exynos7880_decon_get_modes(struct drm_connector *connector)
+{
+	struct exynos7880_decon *decon = to_decon(connector->dev);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &decon->mode);
+	if (!mode)
+		return 0;
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+
+	connector->display_info.width_mm = decon->width_mm;
+	connector->display_info.height_mm = decon->height_mm;
+
+	return 1;
+}
+
+static const struct drm_connector_helper_funcs exynos7880_decon_connector_helper_funcs = {
+	.get_modes = exynos7880_decon_get_modes,
+};
+
+static const struct drm_connector_funcs exynos7880_decon_connector_funcs = {
+	.reset = drm_atomic_helper_connector_reset,
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = drm_connector_cleanup,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+
+/* Display pipe */
+
+static enum hrtimer_restart exynos7880_decon_vblank(struct hrtimer *timer)
+{
+	struct exynos7880_decon *decon =
+		container_of(timer, struct exynos7880_decon, vblank_timer);
+
+	hrtimer_forward_now(timer, decon->vblank_period);
+	drm_crtc_handle_vblank(&decon->pipe.crtc);
+
+	return HRTIMER_RESTART;
+}
+
+static int exynos7880_decon_enable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct exynos7880_decon *decon = pipe_to_decon(pipe);
+
+	hrtimer_start(&decon->vblank_timer, decon->vblank_period, HRTIMER_MODE_REL);
+
+	return 0;
+}
+
+static void exynos7880_decon_disable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct exynos7880_decon *decon = pipe_to_decon(pipe);
+
+	hrtimer_cancel(&decon->vblank_timer);
+}
+
+static enum drm_mode_status
+exynos7880_decon_mode_valid(struct drm_simple_display_pipe *pipe,
+			    const struct drm_display_mode *mode)
+{
+	struct exynos7880_decon *decon = pipe_to_decon(pipe);
+
+	/* the pipeline set up by the bootloader cannot be changed */
+	if (mode->hdisplay != decon->mode.hdisplay ||
+	    mode->vdisplay != decon->mode.vdisplay)
+		return MODE_BAD;
+
+	return MODE_OK;
+}
+
+static int exynos7880_decon_pipe_check(struct drm_simple_display_pipe *pipe,
+				       struct drm_plane_state *plane_state,
+				       struct drm_crtc_state *crtc_state)
+{
+	struct exynos7880_decon *decon = pipe_to_decon(pipe);
+	struct drm_framebuffer *fb = plane_state->fb;
+
+	if (!fb)
+		return 0;
+
+	/* the DMA channel is set up for a packed buffer of the size of the panel */
+	if (fb->width != decon->mode.hdisplay || fb->height != decon->mode.vdisplay ||
+	    fb->pitches[0] != fb->width * 4)
+		return -EINVAL;
+
+	return 0;
+}
+
+static void exynos7880_decon_pipe_update(struct drm_simple_display_pipe *pipe,
+					 struct drm_plane_state *old_state)
+{
+	struct exynos7880_decon *decon = pipe_to_decon(pipe);
+	struct drm_plane_state *state = pipe->plane.state;
+	struct drm_crtc *crtc = &pipe->crtc;
+
+	if (state->fb) {
+		u32 val;
+
+		/* the hardware clears the bit once it has latched the previous address */
+		if (readl_poll_timeout_atomic(decon->idma + IDMA_PINGPONG_UPDATE, val,
+					      !(val & BIT(0)), 100, 20000))
+			dev_warn_once(decon->drm.dev, "previous buffer address was not latched\n");
+
+		writel(drm_fb_dma_get_gem_addr(state->fb, state, 0),
+		       decon->idma + IDMA_BASE_ADDR);
+		writel(BIT(0), decon->idma + IDMA_PINGPONG_UPDATE);
+	}
+
+	if (crtc->state->event) {
+		spin_lock_irq(&crtc->dev->event_lock);
+		if (drm_crtc_vblank_get(crtc) == 0)
+			drm_crtc_arm_vblank_event(crtc, crtc->state->event);
+		else
+			drm_crtc_send_vblank_event(crtc, crtc->state->event);
+		crtc->state->event = NULL;
+		spin_unlock_irq(&crtc->dev->event_lock);
+	}
+}
+
+static const struct drm_simple_display_pipe_funcs exynos7880_decon_pipe_funcs = {
+	.mode_valid = exynos7880_decon_mode_valid,
+	.check = exynos7880_decon_pipe_check,
+	.update = exynos7880_decon_pipe_update,
+	.enable_vblank = exynos7880_decon_enable_vblank,
+	.disable_vblank = exynos7880_decon_disable_vblank,
+};
+
+static const struct drm_mode_config_funcs exynos7880_decon_mode_config_funcs = {
+	.fb_create = drm_gem_fb_create,
+	.atomic_check = drm_atomic_helper_check,
+	.atomic_commit = drm_atomic_helper_commit,
+};
+
+DEFINE_DRM_GEM_DMA_FOPS(exynos7880_decon_fops);
+
+static const struct drm_driver exynos7880_decon_driver = {
+	.driver_features = DRIVER_MODESET | DRIVER_GEM | DRIVER_ATOMIC,
+	.name = "exynos7880-decon",
+	.desc = "Exynos7880 DECON_F (bootloader hand-off)",
+	.major = 1,
+	.minor = 0,
+	.fops = &exynos7880_decon_fops,
+	DRM_GEM_DMA_DRIVER_OPS,
+	DRM_FBDEV_DMA_DRIVER_OPS,
+};
+
+/* Check that the bootloader left a running, matching pipeline */
+static int exynos7880_decon_check_hw(struct exynos7880_decon *decon,
+				     dma_addr_t *fb_addr)
+{
+	struct device *dev = decon->drm.dev;
+	u32 val;
+
+	val = readl(decon->decon + DECON_GLOBAL_CONTROL);
+	if (!(val & DECON_GLOBAL_CONTROL_RUN) || !(val & DECON_GLOBAL_CONTROL_I80IF))
+		return dev_err_probe(dev, -ENODEV,
+				     "the DECON is not running in command mode (0x%x)\n", val);
+
+	val = readl(decon->decon + DECON_DISPIF0_SIZE_CONTROL_0);
+	if (DECON_SIZE_WIDTH(val) != decon->mode.hdisplay ||
+	    DECON_SIZE_HEIGHT(val) != decon->mode.vdisplay)
+		return dev_err_probe(dev, -ENODEV,
+				     "the DECON is set up for %ux%u, not %ux%u\n",
+				     DECON_SIZE_WIDTH(val), DECON_SIZE_HEIGHT(val),
+				     decon->mode.hdisplay, decon->mode.vdisplay);
+
+	val = readl(decon->decon + DECON_WIN_CONTROL(0));
+	if (!(val & DECON_WIN_CONTROL_EN) ||
+	    FIELD_GET(DECON_WIN_CONTROL_CHMAP, val) != DECON_CHMAP_IDMA_G1)
+		return dev_err_probe(dev, -ENODEV,
+				     "window 0 is not fed by IDMA_G1 (0x%x)\n", val);
+
+	*fb_addr = readl(decon->idma + IDMA_BASE_ADDR);
+
+	return 0;
+}
+
+static int exynos7880_decon_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct exynos7880_decon *decon;
+	struct drm_device *drm;
+	dma_addr_t fb_addr;
+	int ret;
+
+	decon = devm_drm_dev_alloc(dev, &exynos7880_decon_driver,
+				   struct exynos7880_decon, drm);
+	if (IS_ERR(decon))
+		return PTR_ERR(decon);
+	drm = &decon->drm;
+
+	decon->decon = devm_platform_ioremap_resource_byname(pdev, "decon");
+	if (IS_ERR(decon->decon))
+		return PTR_ERR(decon->decon);
+
+	decon->idma = devm_platform_ioremap_resource_byname(pdev, "idma");
+	if (IS_ERR(decon->idma))
+		return PTR_ERR(decon->idma);
+
+	of_property_read_u32(np, "width-mm", &decon->width_mm);
+	of_property_read_u32(np, "height-mm", &decon->height_mm);
+
+	ret = of_get_drm_display_mode(np, &decon->mode, NULL, OF_USE_NATIVE_MODE);
+	if (ret)
+		return dev_err_probe(dev, ret, "no display mode\n");
+
+	ret = exynos7880_decon_check_hw(decon, &fb_addr);
+	if (ret)
+		return ret;
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+
+	drm->mode_config.min_width = decon->mode.hdisplay;
+	drm->mode_config.max_width = decon->mode.hdisplay;
+	drm->mode_config.min_height = decon->mode.vdisplay;
+	drm->mode_config.max_height = decon->mode.vdisplay;
+	drm->mode_config.preferred_depth = 24;
+	drm->mode_config.funcs = &exynos7880_decon_mode_config_funcs;
+
+	hrtimer_setup(&decon->vblank_timer, exynos7880_decon_vblank,
+		      CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+	decon->vblank_period = ktime_set(0, NSEC_PER_SEC / drm_mode_vrefresh(&decon->mode));
+
+	ret = drm_vblank_init(drm, 1);
+	if (ret)
+		return ret;
+
+	drm_connector_helper_add(&decon->connector,
+				 &exynos7880_decon_connector_helper_funcs);
+	ret = drm_connector_init(drm, &decon->connector,
+				 &exynos7880_decon_connector_funcs,
+				 DRM_MODE_CONNECTOR_DSI);
+	if (ret)
+		return ret;
+
+	ret = drm_simple_display_pipe_init(drm, &decon->pipe,
+					   &exynos7880_decon_pipe_funcs,
+					   exynos7880_decon_formats,
+					   ARRAY_SIZE(exynos7880_decon_formats),
+					   NULL, &decon->connector);
+	if (ret)
+		return ret;
+
+	drm_mode_config_reset(drm);
+
+	/*
+	 * Take over from the firmware framebuffer, which uses the same memory. This is done as late
+	 * as possible: until here a failure leaves the firmware framebuffer working.
+	 */
+	ret = aperture_remove_conflicting_devices(fb_addr,
+						  decon->mode.hdisplay * decon->mode.vdisplay * 4,
+						  exynos7880_decon_driver.name);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to take over the framebuffer\n");
+
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		return ret;
+
+	drm_client_setup_with_fourcc(drm, DRM_FORMAT_XRGB8888);
+
+	platform_set_drvdata(pdev, drm);
+
+	dev_info(dev, "adopted the bootloader pipeline: %ux%u, framebuffer at %pad\n",
+		 decon->mode.hdisplay, decon->mode.vdisplay, &fb_addr);
+
+	return 0;
+}
+
+static void exynos7880_decon_remove(struct platform_device *pdev)
+{
+	struct drm_device *drm = platform_get_drvdata(pdev);
+
+	drm_dev_unplug(drm);
+	drm_atomic_helper_shutdown(drm);
+}
+
+static void exynos7880_decon_shutdown(struct platform_device *pdev)
+{
+	drm_atomic_helper_shutdown(platform_get_drvdata(pdev));
+}
+
+static const struct of_device_id exynos7880_decon_of_match[] = {
+	{ .compatible = "samsung,exynos7880-decon" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos7880_decon_of_match);
+
+static struct platform_driver exynos7880_decon_platform_driver = {
+	.probe = exynos7880_decon_probe,
+	.remove = exynos7880_decon_remove,
+	.shutdown = exynos7880_decon_shutdown,
+	.driver = {
+		.name = "exynos7880-decon",
+		.of_match_table = exynos7880_decon_of_match,
+	},
+};
+
+drm_module_platform_driver(exynos7880_decon_platform_driver);
+
+MODULE_DESCRIPTION("Exynos7880 DECON_F display controller (bootloader hand-off)");
+MODULE_LICENSE("GPL");
-- 
