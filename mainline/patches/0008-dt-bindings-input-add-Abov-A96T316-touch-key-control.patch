From e59ef0cbbbb63666be8b22327a7d0fc21956e1e2 Mon Sep 17 00:00:00 2001
From: Jimmy <fakeandroit@gmail.com>
Date: Thu, 29 Oct 2026 23:19:04 +0200
Subject: [PATCH 8/9] dt-bindings: input: add Abov A96T316 touch-key controller

Add the binding for the Abov A96T316, a microcontroller that works as a
two-key capacitive touch-key controller (recent apps and back, with a
backlight for the keys). It is found, for example, in the Samsung Galaxy
A5 (2017), where the vendor devicetree calls it abov,mc96ft18xx.

Also add the "abov" vendor prefix.

Assisted-by: Claude:claude-sonnet-5-5
---
 .../bindings/input/abov,a96t316.yaml          | 67 +++++++++++++++++++
 .../devicetree/bindings/vendor-prefixes.yaml  |  2 +
 2 files changed, 69 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/abov,a96t316.yaml

diff --git a/Documentation/devicetree/bindings/input/abov,a96t316.yaml b/Documentation/devicetree/bindings/input/abov,a96t316.yaml
new file mode 100644
index 000000000..4931fc9d2
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/abov,a96t316.yaml
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/abov,a96t316.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Abov A96T316 capacitive touch-key controller
+
+maintainers:
+  - Jimmy <fakeandroit@gmail.com>
+
+description:
+  The A96T316 is a microcontroller used as a two-key capacitive touch-key
+  controller (a "recent apps" key and a "back" key) with a backlight for the
+  keys, for example in the Samsung Galaxy A5 (2017). It signals key events
+  with a level-low interrupt that stays asserted until the status register is
+  read.
+
+allOf:
+  - $ref: input.yaml#
+
+properties:
+  compatible:
+    const: abov,a96t316
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  vdd-supply:
+    description: Power supply of the controller.
+
+  linux,keycodes:
+    minItems: 2
+    maxItems: 2
+    description:
+      Key codes of the two keys, in the order recent apps, back.
+      Default is KEY_APPSELECT and KEY_BACK.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - vdd-supply
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/input/input.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchkey@20 {
+            compatible = "abov,a96t316";
+            reg = <0x20>;
+            interrupt-parent = <&gpio>;
+            interrupts = <4 IRQ_TYPE_LEVEL_LOW>;
+            vdd-supply = <&ldo32>;
+            linux,keycodes = <KEY_APPSELECT>, <KEY_BACK>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/vendor-prefixes.yaml b/Documentation/devicetree/bindings/vendor-prefixes.yaml
index 396044f36..d3d96676a 100644
--- a/Documentation/devicetree/bindings/vendor-prefixes.yaml
+++ b/Documentation/devicetree/bindings/vendor-prefixes.yaml
@@ -36,6 +36,8 @@ patternProperties:
     description: ABB
   "^abilis,.*":
     description: Abilis Systems
+  "^abov,.*":
+    description: Abov Semiconductor Co., Ltd.
   "^abracon,.*":
     description: Abracon Corporation
   "^abt,.*":
