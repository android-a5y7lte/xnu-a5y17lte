From 66c7dc8bbe2a0dece4ab9c237cc9d5bc066dab75 Mon Sep 17 00:00:00 2001
From: Jimmy <fakeandroit@gmail.com>
Date: Fri, 20 Nov 2026 23:07:20 +0200
Subject: [PATCH 21/22] dt-bindings: sound: add the Exynos7880 audio mixer

The audio subsystem of the Exynos7880 has a mixer between the I2S block and
the codec. Describe it.

Assisted-by: Claude:claude-sonnet-5-5
---
 .../sound/samsung,exynos7880-audmixer.yaml    | 62 +++++++++++++++++++
 1 file changed, 62 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/samsung,exynos7880-audmixer.yaml

diff --git a/Documentation/devicetree/bindings/sound/samsung,exynos7880-audmixer.yaml b/Documentation/devicetree/bindings/sound/samsung,exynos7880-audmixer.yaml
new file mode 100644
index 000000000..d88ff9bd3
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/samsung,exynos7880-audmixer.yaml
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/samsung,exynos7880-audmixer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos7880 audio mixer
+
+maintainers:
+  - Jimmy <fakeandroit@gmail.com>
+
+description:
+  The audio mixer of the Exynos7880 audio subsystem sits between the SoC I2S
+  block and the audio codec. It has to be reset, clocked and routed before
+  the audio of the I2S reaches the codec.
+
+properties:
+  compatible:
+    const: samsung,exynos7880-audmixer
+
+  reg:
+    maxItems: 1
+
+  resets:
+    maxItems: 1
+
+  samsung,clk-div:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    description:
+      The mixer system clock divider, until there is a driver for the clock
+      controller of the audio subsystem. A syscon phandle of that controller,
+      the offset of the divider register and the value to write.
+    items:
+      - items:
+          - description: syscon of the audio subsystem clock controller
+          - description: register offset
+          - description: divider value
+
+  samsung,pmu:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Syscon of the power management unit, where the retention of the audio
+      pads is released.
+
+required:
+  - compatible
+  - reg
+  - resets
+  - samsung,clk-div
+  - samsung,pmu
+
+additionalProperties: false
+
+examples:
+  - |
+    audio-mixer@14880000 {
+        compatible = "samsung,exynos7880-audmixer";
+        reg = <0x14880000 0x200>;
+        resets = <&lpass_rst 0>;
+        samsung,clk-div = <&cmu_dispaud 0x410 3>;
+        samsung,pmu = <&pmu_system_controller>;
+    };
-- 
