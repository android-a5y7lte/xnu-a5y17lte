# Galaxy A5 (2017) mainline: M1 console, M2 keys, M3 eMMC, M4 USB gadget networking,
# M5 postmarketOS root filesystem, W0 Waydroid options + simpledrm.
# Applied on top of `make allnoconfig`. Only built-in drivers, no modules.

# Kernel release "7.2.0-a5y17lte" for both the FIT kernel and the pmOS
# package (the build scripts set LOCALVERSION empty: no "+" from git), so
# /usr/lib/modules/<release>/modules.builtin in Nura matches uname -r
CONFIG_LOCALVERSION="-a5y17lte"

# Platform
CONFIG_ARCH_EXYNOS=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_HOTPLUG_CPU=y
CONFIG_ARM_PSCI_FW=y

# Core
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Console on the boot framebuffer (simple-framebuffer at 0x67000000).
# W0: simpledrm instead of FB_SIMPLE, so the same buffer is also a KMS device
# (/dev/dri/card0) for wlroots/phoc and Waydroid. It never touches DECON, so
# the TE refresh set up before Linux keeps working. fbcon via fbdev emulation.
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# Reboot via PMU (syscon-reboot) and reboot modes (recovery = TWRP)
CONFIG_MFD_SYSCON=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y

# M2: ALIVE pinctrl, GPIO keys, input events
CONFIG_PINCTRL=y
CONFIG_PINCTRL_EXYNOS=y
CONFIG_GPIOLIB=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y

# M3: eMMC (DW-MSHC Exynos), block layer, partition tables
CONFIG_COMMON_CLK=y
CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_EXYNOS=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# M3b: debugfs for the eMMC clock sweep (mmc0/clock)
CONFIG_DEBUG_FS=y

# M4: CMU_FSYS (Exynos7870 driver), USB DRD PHY, DWC3 peripheral
CONFIG_COMMON_CLK_SAMSUNG=y
CONFIG_EXYNOS_ARM64_COMMON_CLK=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y
# networking for usb0 (SSH/telnet over USB)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_PROC_SYSCTL=y

# M4c: GPIO I2C to the S2MU004 MUIC, /dev/i2c-N for userspace
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_GPIO=y

# M5: a distro root filesystem (postmarketOS, OpenRC) on the SYSTEM partition.
# From pmaports kconfigcheck.toml categories default, nftables and zram, all
# built in. Deferred: MODULE_COMPRESS* (no modules), FW_LOADER_COMPRESS* (no
# firmware yet), BTF/KPROBES/FTRACE/BPF_LSM/SECURITY* (debug and LSM extras),
# UDMABUF. (DRM_FBDEV_EMULATION came with W0's simpledrm.)
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
# M5d: boot Nura with SYSTEM read-only under a RAM (tmpfs) overlay
CONFIG_OVERLAY_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_UTF8=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_AUTOFS_FS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PSI=y
CONFIG_UEVENT_HELPER=y
CONFIG_RD_ZSTD=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_NULL_TTY=y
CONFIG_SYN_COOKIES=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# full-disk encryption (pmOS installer option)
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_XTS=y
# zram swap (pmOS zram-init)
CONFIG_SWAP=y
CONFIG_BLK_DEV=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZO=y
# nftables (pmOS firewall, enabled by default)
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NF_NAT=y
CONFIG_NF_REJECT_IPV4=y
CONFIG_NF_REJECT_IPV6=y

# W0: Waydroid (Android in an LXC container on Nura). Matches pmaports
# kconfigcheck.toml (f3f92690) category waydroid, all built in, with one
# deliberate difference: pmaports asks ANDROID_BINDERFS=n, we keep it =y
# because AOSP (R and later) requires binderfs (phase A). With binderfs on,
# the three devices below appear inside every binderfs mount (binder.c skips
# the /dev/binder misc nodes); Waydroid mounts binderfs at /dev/binderfs.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# LXC: veth pair into the container, cpuset cgroup, FUSE for Android storage,
# loop + squashfs for the Waydroid system/vendor images, TUN, process_vm_*
CONFIG_NET_CORE=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_CPUSETS=y
CONFIG_FUSE_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_XZ=y
CONFIG_CROSS_MEMORY_ATTACH=y
# waydroid-net.sh: bridge waydroid0, NAT to the host. It defaults to iptables
# (legacy first) with a mangle CHECKSUM rule for DHCP replies; nftables only
# when LXC_USE_NFT=true. Both kept: legacy tables and iptables-nft (compat).
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_MANGLE=y

# /dev/mem: milestone-1 init may push frames to the command-mode panel
CONFIG_DEVMEM=y

# Keep the image small
# CONFIG_MODULES is not set
# CONFIG_DEBUG_INFO is not set
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_ZINITIX=y

# Wi-Fi bring-up (EVIDENCE 35): QCA9377 on SDIO via ath10k_sdio (built in, no modules)
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SDIO=y
