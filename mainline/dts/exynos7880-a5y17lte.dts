// SPDX-License-Identifier: GPL-2.0
/*
 * Samsung Galaxy A5 (2017), SM-A520F - M4 (console, keys, eMMC, USB gadget)
 *
 *  [D] Samsung universal7880 kernel: exynos7880-a5y17lte_common.dtsi,
 *      exynos7880-rmem.dtsi
 *  [H] a5y17lte hardware readings, EVIDENCE.md section 12
 */

/dts-v1/;
#include "exynos7880.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Samsung Galaxy A5 (2017)";
	compatible = "samsung,a5y17lte", "samsung,exynos7880";
	chassis-type = "handset";

	aliases {
		mmc0 = &mmc0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		bootargs = "console=tty0 loglevel=7 panic=20 clk_ignore_unused pd_ignore_unused regulator_ignore_unused fbcon=font:TER16x32";

		/* [H] 0x67000000, 1080x1920, ARGB8888 (R G B W bars confirmed) */
		framebuffer@67000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x67000000 (1080 * 1920 * 4)>;
			width = <1080>;
			height = <1920>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * [D] exynos7880-a5y17lte_common.dtsi gpio_keys: power gpa0-0 (116),
	 * volume down gpa2-1 (114), volume up gpa2-0 (115), home gpa1-7 (172);
	 * identical to mainline exynos7870-j5y17lte.dts.
	 */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&key_power &key_voldown &key_volup &key_home>;

		key-home {
			/* Phosh binds Super (toggles the overview) and nothing on XF86HomePage
			 * (EVIDENCE 38) */
			linux,code = <KEY_LEFTMETA>;
			label = "gpio-keys: KEY_LEFTMETA (Home)";
			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		key-power {
			linux,code = <KEY_POWER>;
			label = "gpio-keys: KEY_POWER";
			gpios = <&gpa0 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		key-voldown {
			linux,code = <KEY_VOLUMEDOWN>;
			label = "gpio-keys: KEY_VOLUMEDOWN";
			gpios = <&gpa2 1 GPIO_ACTIVE_LOW>;
		};

		key-volup {
			linux,code = <KEY_VOLUMEUP>;
			label = "gpio-keys: KEY_VOLUMEUP";
			gpios = <&gpa2 0 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * [D] exynos7880-a5y17lte_common.dtsi s2mpu05 PMIC: the USB PHY
	 * supplies LDO8 (3.3 V, vdd33), LDO1 (vdd10) and LDO3 (dwc3-vbus) are
	 * all regulator-boot-on + regulator-always-on, so S-Boot turns them on
	 * and nothing turns them off. Until the PMIC has a driver here they are
	 * described as always-on fixed regulators.
	 */
	vdd_ldo1: regulator-ldo1 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_ldo1";
		regulator-min-microvolt = <1000000>;
		regulator-max-microvolt = <1000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vdd_ldo8: regulator-ldo8 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_ldo8";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * [D] exynos7880-a5y17lte_common.dtsi: S2MU004 (charger + MUIC that
	 * routes the USB D+/D- lines) at 0x3d on i2c@13870000, pins gpc1-0
	 * (SDA) / gpc1-1 (SCL) [D] i2c0_bus. Driven as a GPIO bit-banged bus
	 * until the 7880 CMU_PERI (I2C clock) is supported; userspace reads and
	 * sets the MUIC switch through /dev/i2c-N.
	 */
	i2c_muic: i2c-gpio-muic {
		compatible = "i2c-gpio";
		sda-gpios = <&gpc1 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpc1 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	/*
	 * Touchscreen bring-up (EVIDENCE 31), bit-banged until the CMU_PERI I2C
	 * clocks are supported. [D] PMIC: S2MPU05 at 7-bit 0x66 on
	 * hsi2c@10610000, gpm0-0 (SDA) / gpm0-1 (SCL), supplies the touch IC
	 * through LDO34. [D] Touch: i2c@13890000, gpc2-0 (SDA) / gpc2-1 (SCL), IC at
	 * 0x20 (Zinitix) or 0x48 (sec_ts) depending on the board revision.
	 */
	i2c_pmic: i2c-gpio-pmic {
		compatible = "i2c-gpio";
		sda-gpios = <&gpm0 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpm0 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	/*
	 * Touch-key MCU bring-up (EVIDENCE 38): [D] common dtsi i2c@20 (i2c-gpio): SDA gpd4-5, SCL
	 * gpd4-3, "abov,mc96ft18xx" at 0x20, IRQ gpa1-4. Driver-less: userspace probes it with
	 * i2c-tools; its supply (probably a PMIC LDO) is switched on from userspace for now.
	 */
	i2c_tkey: i2c-gpio-tkey {
		compatible = "i2c-gpio";
		sda-gpios = <&gpd4 5 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpd4 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	i2c_touch: i2c-gpio-touch {
		compatible = "i2c-gpio";
		sda-gpios = <&gpc2 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpc2 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		#address-cells = <1>;
		#size-cells = <0>;
	
		/*
		 * [H] A device ACKs at 0x20 once gpd1-4 is high (EVIDENCE 31). [D] common
		 * dtsi: zinitix ZT7538, IRQ gpa0-5, 1080x1920, supply tsp_avdd.
		 */
		touchscreen@20 {
			compatible = "zinitix,bt538";
			reg = <0x20>;
			interrupt-parent = <&gpa0>;
			interrupts = <5 IRQ_TYPE_LEVEL_LOW>;
			pinctrl-names = "default";
			pinctrl-0 = <&touch_irq>;
			vdd-supply = <&tsp_avdd>;
			touchscreen-size-x = <1080>;
			touchscreen-size-y = <1920>;
		};
	};

	/* [D] exynos7880-a5y17lte_eur_open_05.dts tsp_avdd: gpd1-4, 3.3 V */
	tsp_avdd: regulator-tsp-avdd {
		compatible = "regulator-fixed";
		regulator-name = "tsp_avdd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpd1 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/* [D] memory@40000000 0x3E400000 and memory@80000000 0x80000000 (3 GB) */
	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x3e400000>,
		      <0x0 0x80000000 0x80000000>;
	};

	/*
	 * Milestone 1 is conservative: every Samsung carve-out is no-map, so
	 * Linux never touches memory that firmware, modem or the secure world
	 * may own. [D] rmem: 0x7E400000-0x80000000 is secure DRAM and is
	 * already outside the memory node above.
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * [H] A write here makes the next plain reset hang at the Samsung logo
		 * (EVIDENCE 29: bad at 0x48000000 and 0x48010000/0x48014000, fine at
		 * 0x47fff000 and 0x48018000; 128 KiB covers it). Not used for Linux.
		 */
		sboot-reset@48000000 {
			reg = <0x0 0x48000000 0x20000>;
			no-map;
		};

		/* [D] extra_info */
		extra-info@45fff000 {
			reg = <0x0 0x45fff000 0x1000>;
			no-map;
		};

		/* [D] tima_region (Samsung TIMA) */
		tima@52800000 {
			reg = <0x0 0x52800000 0x200000>;
			no-map;
		};

		/* [H] boot framebuffer, then [D] dram_init 0x67FFF000, modem_if
		 * 0x68000000, gnss_if 0x70000000, /memreserve/ 0x70400000,
		 * gpu_crc, gpu_buffer, crypto, video_nfw/fw/stream/frame up to
		 * 0x7C800000; whole range kept out until it is understood */
		framebuffer@67000000 {
			reg = <0x0 0x67000000 0x17400000>;
			no-map;
		};

		/*
		 * [D] rmem.dtsi: "0x7E400000 ~ 0x80000000 is used for secure DRAM".
		 * Outside the memory node above, but U-Boot (board/samsung/common
		 * dram_init_banksize) reports 0x40000000-0x100000000 as contiguous
		 * banks and rewrites /memory on boot, so keep it out explicitly.
		 */
		secure-dram@7e400000 {
			reg = <0x0 0x7e400000 0x1c00000>;
			no-map;
		};

		/* [D] video_scaler (secure ION) */
		video-scaler@80000000 {
			reg = <0x0 0x80000000 0x3c00000>;
			no-map;
		};
	};
};

/*
 * eMMC. [D] exynos7880-a5y17lte_common.dtsi dwmmc0: 8-bit, non-removable,
 * fifo-depth 0x40, ciu-div 3, sdr-timing <3 0 2 0>, ddr-timing <3 0 4 2>.
 * Samsung cells are <div fine-drive drive sample>; mainline takes
 * <sample drive>, so SDR <0 2>, DDR <2 4> (the same conversion of Samsung's
 * 7870 values gives mainline exynos7870-j5y17lte's <0 4>/<2 4>).
 * Milestone 3 is conservative: high-speed SDR at 52 MHz max, no DDR/HS200/
 * HS400 (those need tuning and the 1.8 V I/O regulator), no pinctrl or
 * regulators (S-Boot leaves pins and supplies configured and on).
 */
&mmc0 {
	bus-width = <8>;
	non-removable;
	cap-mmc-highspeed;
	max-frequency = <52000000>;
	fifo-depth = <64>;
	samsung,dw-mshc-ciu-div = <3>;
	samsung,dw-mshc-sdr-timing = <0 2>;
	samsung,dw-mshc-ddr-timing = <2 4>;
	status = "okay";
};

/*
 * [D] usb@13600000: vdd33 LDO8, vdd10 LDO1, high-speed. Samsung uses
 * dr_mode "otg" with its own MUIC/CCIC notifier; with no cable detection
 * here, run as a USB peripheral only (gadget networking + serial).
 */
&usbdrd {
	vdd33-supply = <&vdd_ldo8>;
	vdd10-supply = <&vdd_ldo1>;
	status = "okay";
};

&usb_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
};

/* [D] key-power/voldown/volup/home: function 0xf (EINT), pud 0, drv 0 */
&pinctrl_alive {
	/* [D] attn_irq: gpa0-5, function 0xf (EINT), pud 0 */
	touch_irq: touch-irq-pins {
		samsung,pins = "gpa0-5";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	key_power: key-power-pins {
		samsung,pins = "gpa0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	key_voldown: key-voldown-pins {
		samsung,pins = "gpa2-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	key_volup: key-volup-pins {
		samsung,pins = "gpa2-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	key_home: key-home-pins {
		samsung,pins = "gpa1-7";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};
};

/*
 * Wi-Fi bring-up (EVIDENCE 35): Qualcomm QCA9377 on SDIO (mmc1). [D] eur_open_05:
 * `wlan` WLAN_EN gpd3-6, host wake gpa2-2, supply cnss_dcdc_en = regulator-fixed on
 * gpd3-3 (4 ms startup); pins and timings as in the Exynos7870 boards that use
 * the same sd1 pins (j7xelte). The card is powered through vmmc, then WLAN_EN is
 * released by the MMC power sequence.
 */
&pinctrl_fsys {
	sd1_clk: sd1-clk-pins {
		samsung,pins = "gpr2-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR3>;
	};

	sd1_cmd: sd1-cmd-pins {
		samsung,pins = "gpr2-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR3>;
	};

	sd1_bus1: sd1-bus-width1-pins {
		samsung,pins = "gpr3-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_INPUT>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR3>;
	};

	sd1_bus4: sd1-bus-width4-pins {
		samsung,pins = "gpr3-1", "gpr3-2", "gpr3-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_INPUT>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR3>;
	};
};

&pinctrl_top {
	/* [D] cnss_wlanen: WLAN_EN gpd3-6 as a GPIO output, low */
	wlan_en: wlan-en-pins {
		samsung,pins = "gpd3-6";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR3>;
	};
};

/ {
	cnss_dcdc_en: regulator-cnss-dcdc-en {
		compatible = "regulator-fixed";
		regulator-name = "cnss_dcdc_en";
		/* the MMC core needs a voltage range to derive the OCR mask (m8a: -EINVAL) */
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <4000>;
		enable-active-high;
		gpio = <&gpd3 3 GPIO_ACTIVE_HIGH>;
	};

	pwrseq_wifi: pwrseq-wifi {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en>;
		reset-gpios = <&gpd3 6 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <100>;
	};
};

&mmc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&sd1_clk &sd1_cmd &sd1_bus1 &sd1_bus4>;
	vmmc-supply = <&cnss_dcdc_en>;
	mmc-pwrseq = <&pwrseq_wifi>;

	bus-width = <4>;
	fifo-depth = <64>;
	samsung,dw-mshc-ciu-div = <3>;
	samsung,dw-mshc-sdr-timing = <0 3>;
	samsung,dw-mshc-ddr-timing = <1 2>;
	max-frequency = <25000000>;
	non-removable;
	cap-sd-highspeed;
	cap-sdio-irq;
	status = "okay";
};

/*
 * S2MPU05 PMIC (EVIDENCE 38): [D] hsi2c@10610000, 7-bit 0x66, interrupt gpa0-2; bit-banged on
 * gpm0-0/1 for now. Only the LDOs the touch-key controller needs are described; the other rails
 * keep the state S-Boot left them in (`regulator_ignore_unused` is on the command line).
 */
&i2c_pmic {
	pmic@66 {
		compatible = "samsung,s2mpu05-pmic";
		reg = <0x66>;
		interrupt-parent = <&gpa0>;
		interrupts = <2 IRQ_TYPE_LEVEL_LOW>;

		regulators {
			ldo32: ldo32 {
				regulator-name = "vtouch_2.8v";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};

			/* [D] vtouch_3.3v (LDO35): the supply of the key backlight (EVIDENCE 38) */
			ldo35: ldo35 {
				regulator-name = "vtouch_3.3v";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};
		};
	};
};

/* [D] abov@20 on the touch-key i2c-gpio bus; [D] cfg_irq: gpa1-4 EINT, no pull */
&pinctrl_alive {
	tkey_irq: tkey-irq-pins {
		samsung,pins = "gpa1-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};
};

&i2c_tkey {
	touchkey@20 {
		compatible = "abov,a96t316";
		reg = <0x20>;
		interrupt-parent = <&gpa1>;
		interrupts = <4 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&tkey_irq>;
		vdd-supply = <&ldo32>;
		led-supply = <&ldo35>;
		/* Esc is the "back" action on Wayland/GTK; recents stays APPSELECT */
		linux,keycodes = <KEY_APPSELECT>, <KEY_ESC>;
	};
};

/*
 * Display (EVIDENCE 40): S6E3FA3 panel, 1080x1920, 65x115 mm, command mode; [D] common dtsi s6e3fa3:
 * h-porch <2 2 2> (back, front, sync), v-porch <15 3 1>, 60 Hz. Pixel clock for 60 Hz with these
 * totals (1086 x 1939): 126342840 Hz. Only the active size has to match what S-Boot programmed.
 */
&decon {
	width-mm = <65>;
	height-mm = <115>;
	/* untested: enabled by `DECON=1 ./build-mainline.sh` (the display driver replaces simpledrm) */
	status = "disabled";

	display-timings {
		native-mode = <&panel_timing>;

		panel_timing: timing-0 {
			clock-frequency = <126342840>;
			hactive = <1080>;
			vactive = <1920>;
			hback-porch = <2>;
			hfront-porch = <2>;
			hsync-len = <2>;
			vback-porch = <15>;
			vfront-porch = <3>;
			vsync-len = <1>;
		};
	};
};

/*
 * Vibrator (EVIDENCE 42): [D] eur_open_05.dts sec_vib { ldo_type 1 (a GPIO LDO), ldo_en = <&gpd2 3> }: the
 * motor is a plain on/off switch on gpd2-3 (on the older revision 00 the same pin is the touch supply).
 */
/ {
	vibrator {
		compatible = "gpio-vibrator";
		enable-gpios = <&gpd2 3 GPIO_ACTIVE_HIGH>;
	};
};
